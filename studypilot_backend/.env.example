SECRET_KEY=change-me
DEBUG=False

# Comma-separated hosts/origins. Add your deployed Vercel URLs in production.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app,https://your-frontend.vercel.app

# Supabase PostgreSQL. Keep this backend-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_CONN_MAX_AGE=0

# Local PostgreSQL fallback when DATABASE_URL is empty.
DATABASE_NAME=studypilot_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Supabase OAuth verification. Use the anon/publishable key, never service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# DeepSeek V4 Flash, backend only.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
MAX_DEEPSEEK_CONTEXT_CHARS=20000

# Upload and extraction limits.
MAX_PDF_PAGES=50
MAX_EXTRACTED_TEXT_CHARS=80000
MAX_UPLOAD_SIZE=52428800

# Resource Hub APIs, backend only.
YOUTUBE_API_KEY=your_youtube_api_key_here
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
OPENALEX_EMAIL=your_email_optional

# Temporary DOCX storage. Use /tmp/youtube_docx on Vercel.
YOUTUBE_DOCX_TEMP_DIR=temp/youtube_docx
YOUTUBE_DOCX_EXPIRY_MINUTES=60
YOUTUBE_AUDIO_TEMP_DIR=temp/youtube_audio
ENABLE_AUDIO_TRANSCRIPTION=True
WHISPER_MODEL_SIZE=base

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
